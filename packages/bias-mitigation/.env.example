# Choose your model for small service
SGLANG_SMALL_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Alternative: SGLANG_SMALL_MODEL=Qwen/Qwen2.5-7B-Instruct

# 70B model (recommended AWQ-INT4 – fits perfectly on your 2×48 GB)
SGLANG_LARGE_MODEL=hugging-quants/Meta-Llama-3.1-70B-Instruct-AWQ-INT4

HUGGING_FACE_HUB_TOKEN=your_hugging_face_token_here
HF_TOKEN=your_hugging_face_token_here

OPENAI_API_KEY=local
MONGO_USERNAME=admin
MONGO_ROOT_PASSWORD=qwfpbb
OLLAMA_PORT=11434
MONGO_PORT=27017
MONGO_ROOT_USER=neo4j
NEO4J_BROWSER_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=password
NEO4J_USERNAME=neo4j
NEO4J_URL=bolt://localhost:7687
TELEMETRY_DISABLED=true

COMPOSE_PROJECT_NAME=sglang-cluster
